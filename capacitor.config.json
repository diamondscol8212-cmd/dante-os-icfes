{
  "appId": "com.danteos.app",
  "appName": "Dante OS - ICFES",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": false,
    "hostname": "danteos.app",
    "allowNavigation": [
      "https://*.onrender.com",
      "https://*.supabase.co"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0f172a",
      "showSpinner": false,
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#10b981"
    },
    "AdMob": {
      "appIdAndroid": "ca-app-pub-3940256099942544~3347511713",
      "appIdIos": "ca-app-pub-3940256099942544~1458002511",
      "initializeForTesting": true,
      "_TODO_PUBLICAR": [
        "1. Sustituir appIdAndroid / appIdIos por los App ID reales de AdMob",
        "2. Poner initializeForTesting en false",
        "3. Rellenar REAL_APP_ID y REAL_INTERSTITIAL_ID en public/js/danteAds.js",
        "4. Actualizar android/app/src/main/AndroidManifest.xml → APPLICATION_ID"
      ]
    }
  }
}

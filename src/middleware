import jwt from 'jsonwebtoken';

const JWT_SECRET = process.env.JWT_SECRET || 'dante_os_jwt_secret_key_2026_production';

export function autenticarToken(req, res, next) {
  const authHeader = req.headers['authorization'];
  const token = authHeader && authHeader.split(' ')[1];

  if (!token) {
    return res.status(401).json({
      success: false,
      error: 'Acceso denegado: Token de autenticación no proporcionado'
    });
  }

  try {
    const usuarioVerificado = jwt.verify(token, JWT_SECRET);
    req.user = usuarioVerificado;
    next();
  } catch (error) {
    return res.status(403).json({
      success: false,
      error: 'Token inválido o expirado'
    });
  }
}

export function verificarRol(...rolesPermitidos) {
  return (req, res, next) => {
    if (!req.user || !rolesPermitidos.includes(req.user.rol)) {
      return res.status(403).json({
        success: false,
        error: 'Acceso prohibido: Privilegios insuficientes para esta operación'
      });
    }
    next();
  };
}
